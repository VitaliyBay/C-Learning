CC = gcc

CFLAGS = -std=c11 -Wall -Wextra -Werror -I../common

TARGET_VALIDATIONS = test_validations

SRC_VALIDATIONS = test_validations.c ../common/validations.c

OBJ_VALIDATIONS = $(SRC_VALIDATIONS:.c=.o)

TARGET_VALIDATIONS_ENCODING = test_encoding

SRC_VALIDATIONS_ENCODING = test_encoding.c ../common/encoding.c

OBJ_VALIDATIONS_ENCODING = $(SRC_VALIDATIONS_ENCODING:.c=.o)

TARGET_VALIDATIONS_TELEMETRY_CODEC = test_telemetry_codec

SRC_VALIDATIONS_TELEMETRY_CODEC = test_telemetry_codec.c ../common/telemetry_codec.c ../common/encoding.c

OBJ_VALIDATIONS_TELEMETRY_CODEC = $(SRC_VALIDATIONS_TELEMETRY_CODEC:.c=.o)

TARGET_VALIDATIONS_PROTOCOL = test_protocol

SRC_VALIDATIONS_PROTOCOL = test_protocol.c ../common/protocol.c

OBJ_VALIDATIONS_PROTOCOL = $(SRC_VALIDATIONS_PROTOCOL:.c=.o)

all: validations encoding telemetry_codec protocol

$(TARGET_VALIDATIONS): $(OBJ_VALIDATIONS)
	$(CC) $(OBJ_VALIDATIONS) -o $(TARGET_VALIDATIONS)

%.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

clean:
	rm -f $(OBJ_VALIDATIONS) $(TARGET_VALIDATIONS) $(OBJ_VALIDATIONS_ENCODING) $(TARGET_VALIDATIONS_ENCODING) $(OBJ_VALIDATIONS_TELEMETRY_CODEC) $(TARGET_VALIDATIONS_TELEMETRY_CODEC) $(OBJ_VALIDATIONS_PROTOCOL) $(TARGET_VALIDATIONS_PROTOCOL)

# Validations
validations: $(TARGET_VALIDATIONS)
	./$(TARGET_VALIDATIONS)

# Encoding
$(TARGET_VALIDATIONS_ENCODING): $(OBJ_VALIDATIONS_ENCODING)
	$(CC) $(OBJ_VALIDATIONS_ENCODING) -o $(TARGET_VALIDATIONS_ENCODING)

encoding: $(TARGET_VALIDATIONS_ENCODING)
	./$(TARGET_VALIDATIONS_ENCODING) 

# Telemetry
$(TARGET_VALIDATIONS_TELEMETRY_CODEC): $(OBJ_VALIDATIONS_TELEMETRY_CODEC)
	$(CC) $(OBJ_VALIDATIONS_TELEMETRY_CODEC) -lm -o $(TARGET_VALIDATIONS_TELEMETRY_CODEC)

telemetry_codec: $(TARGET_VALIDATIONS_TELEMETRY_CODEC)
	./$(TARGET_VALIDATIONS_TELEMETRY_CODEC) 

# Protocol
$(TARGET_VALIDATIONS_PROTOCOL): $(OBJ_VALIDATIONS_PROTOCOL)
	$(CC) $(OBJ_VALIDATIONS_PROTOCOL) -lm -o $(TARGET_VALIDATIONS_PROTOCOL)

protocol: $(TARGET_VALIDATIONS_PROTOCOL)
	./$(TARGET_VALIDATIONS_PROTOCOL) 